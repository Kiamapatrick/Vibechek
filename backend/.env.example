# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=vibeshield

# Groq LLM (optional for baseline-only)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_MAX_RETRIES=3
GROQ_TIMEOUT=30.0

# Scanner defaults
DEFAULT_TIMEOUT=10.0
DEFAULT_MAX_PAGES=20
DEFAULT_MAX_DEPTH=2

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]