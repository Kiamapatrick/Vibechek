# Copy to .env (never commit .env). Placeholders only.

# --- MongoDB (backend) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=vibeshield

# --- Groq LLM (optional: baseline-only triage works without it) ---
GROQ_API_KEY=gsk_your_key_here
# Model: set GROQ_MODEL or MODEL (alias). Default: openai/gpt-oss-20b
# GROQ_MODEL=openai/gpt-oss-20b

# --- API (backend) ---
CORS_ORIGINS=["http://localhost:3000"]
# Set true only for local development against private/localhost targets
ALLOW_PRIVATE_TARGETS=false
