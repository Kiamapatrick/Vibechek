# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=vibeshield

# Groq LLM (optional for baseline-only triage)
GROQ_API_KEY=
# Model can be set via GROQ_MODEL or MODEL (alias)
# GROQ_MODEL=openai/gpt-oss-20b

# Scanner defaults
DEFAULT_TIMEOUT=10.0
DEFAULT_MAX_PAGES=20
DEFAULT_MAX_DEPTH=2

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# Security
ALLOW_PRIVATE_TARGETS=false